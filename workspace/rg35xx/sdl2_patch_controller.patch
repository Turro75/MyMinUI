+int MY_ForceCustomControllerDetection(int fd,struct input_id inpid, const char* name, char **name_return, Uint16 *vendor_return, Uint16 *product_return, SDL_JoystickGUID *guid){
+    // patch to force the internal controller seen as sdl2 gamecontroller
+    if (ioctl(fd, EVIOCGID, &inpid) >= 0) {
+        if (inpid.vendor == 0x0001 && inpid.product == 0x0001) {
+            if (name_return) {
+                 *name_return = SDL_strdup(name);
+            }
+            if (guid) {
+                *guid = SDL_CreateJoystickGUID(inpid.bustype, inpid.vendor, inpid.product, inpid.version, NULL, name, 0, 0);
+            }
+            *vendor_return = inpid.vendor;
+            *product_return = inpid.product;
+            //printf("Joystick: %s, bustype = %d, vendor = 0x%.4x, product = 0x%.4x, version = %d\n", *name_return, inpid.bustype, inpid.vendor, inpid.product, inpid.version);
+            return 1; // ok the joystick is valid!
+        }
+    }
+    return 0;
+}
