#!/bin/sh

# NOTE: becomes .tmp_update/updater

INFO=`cat /proc/cpuinfo 2> /dev/null`
case $INFO in
*"Allwinner"*)
	PLATFORM="trimui"
	;;
*"sun8i"*)
	if [ -d /usr/miyoo ]; then
		PLATFORM="my282"
	else
		PLATFORM="trimuismart"
	fi
	;;
*"SStar"*)
	PLATFORM="miyoomini"
	;;
*"TG5040"*)
	PLATFORM="tg5040"
	;;
esac

if [ ! -f /mnt/SDCARD/.tmp_update/$PLATFORM.sh ]; then
    cp -Rf /mnt/SDCARD/miyoo/app/.tmp_update /mnt/SDCARD/
    cp -Rf /mnt/SDCARD/miyoo354/app/.tmp_update /mnt/SDCARD/
fi
UPDATERCNT=$(pgrep -f "keymon.elf" | wc -l)
sync
if [ "$UPDATERCNT" -gt 0 ]; then
	if [ $(pgrep -f '/customer/main' | grep -v 'pgrep' | wc -l) -gt 1 ]; then echo "killing customer/main" >&2 ; kill -9 $(pgrep -f '/customer/main' | grep -v 'pgrep' | tail -n 1); fi
	if [ $(pgrep -f 'tee' | grep -v "pgrep" | wc -l) -gt 1 ]; then echo 'killing tee' >&2 ; kill -9 $(pgrep -f 'tee' | grep -v "pgrep" |  tail -n 1); fi
	kill $$
fi

/mnt/SDCARD/.tmp_update/$PLATFORM.sh # &> /mnt/SDCARD/boot.txt

# force shutdown so nothing can modify the SD card
echo s > /proc/sysrq-trigger
echo u > /proc/sysrq-trigger
echo o > /proc/sysrq-trigger
